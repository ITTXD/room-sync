# RoomSync Environment Configuration for Supabase & Cloudflare

# 1. Supabase Connection String (Transaction Pooler - port 6543, recommended for Cloudflare & serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Direct URL (Direct Connection - port 5432, used by Prisma migrations & db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. Authentication Secret (32+ random characters for JWT / Iron-session cookie encryption)
AUTH_SECRET="roomsync-enterprise-hmac-sha256-secret-key-2026-secure"
