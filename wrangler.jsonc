{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "room-sync",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "f67a7f0e06104f0e83bcfa8863a3325f"
		}
	],
	"vars": {
		"AUTH_SECRET": "roomsync-enterprise-hmac-sha256-secret-key-2026-secure"
	}
}